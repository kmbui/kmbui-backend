{
  "name": "kmbui-backend",
  "version": "1.0.50",
  "scripts": {
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
    "test": "rm -f ./coverage/lcov.info && bun test && genhtml ./coverage/lcov.info -o ./coverage/html/",
    "dev": "bun run --watch src/index.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.13",
    "@libsql/client": "^0.15.15",
    "@sinclair/typebox": "^0.34.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.19",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "dotenv": "^17.2.3"
  },
  "overrides": {
    "@sinclair/typebox": "0.34.0"
  },
  "module": "src/index.js"
}
